<Window x:Class="AudioLatency.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Latency Lab"
        Width="1120" Height="860" MinWidth="980" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="#101318" Foreground="#EDF1F7"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B22" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1D232C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#2B333F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A2ADBC" />
        <SolidColorBrush x:Key="FaintBrush" Color="#778393" />
        <SolidColorBrush x:Key="AccentBrush" Color="#65D6C0" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#17483F" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F0BE73" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F28A8A" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F3F6FA" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF1F7" />
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="BorderBrush" Value="#343D49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#65D6C0" />
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF1F7" />
            <Setter Property="Background" Value="#11151B" />
            <Setter Property="BorderBrush" Value="#343D49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EDF1F7" />
                        <Setter Property="Background" Value="#171B22" />
                        <Setter Property="Padding" Value="9,7" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#27333D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#17483F" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <!-- One full-field hit target opens the list from the device name or arrow. -->
                                <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press" Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ArrowBorder" Background="Transparent" CornerRadius="7">
                                                <TextBlock Text="⌄" Foreground="#AAB6C3" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ArrowBorder" Property="Background" Value="#27313B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Grid.Column="0" Margin="10,0,3,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  IsHitTestVisible="False" />
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                                <Border x:Name="DropDownBorder" Background="#171B22" BorderBrush="#343D49" BorderThickness="1"
                                        CornerRadius="7" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="3" SnapsToDevicePixels="True" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#65D6C0" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#65D6C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0F6" />
            <Setter Property="Background" Value="#242B35" />
            <Setter Property="BorderBrush" Value="#3A4552" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303946" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#566575" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#65D6C0" />
            <Setter Property="BorderBrush" Value="#65D6C0" />
            <Setter Property="Foreground" Value="#09231F" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#EDF1F7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#FFD7D7" />
            <Setter Property="Background" Value="#45282B" />
            <Setter Property="BorderBrush" Value="#754044" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202630" />
            <Setter Property="Foreground" Value="#AEB8C5" />
            <Setter Property="BorderBrush" Value="#303844" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#171B22" />
            <Setter Property="Foreground" Value="#DFE5ED" />
            <Setter Property="BorderBrush" Value="#252C35" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="38" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202832" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#183B37" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#13171D" BorderBrush="#252C35" BorderThickness="0,0,0,1" Padding="26,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="#1C3937" VerticalAlignment="Center">
                    <TextBlock Text="◖" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AUDIO LATENCY LAB" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="Measure the path from sound submission to microphone capture" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#20262F" BorderBrush="#303844" BorderThickness="1" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="AppStatusText" Text="READY" FontSize="10" FontWeight="Bold" Foreground="#CBD5E0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,22,26,30">
                <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#3A2326" BorderBrush="#744047" BorderThickness="1"
                        CornerRadius="10" Padding="13,11" Margin="0,0,0,14">
                    <TextBlock x:Name="ErrorText" Foreground="#FFD0D2" TextWrapping="Wrap" />
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,17">
                            <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,9,0" />
                            <TextBlock Text="Set up a measurement" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="  Choose the playback path and microphone" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="7,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="OUTPUT DEVICE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="↻  Refresh" Style="{StaticResource QuietButton}"
                                        Click="RefreshDevicesButton_Click" ToolTip="Refresh Windows audio devices" />
                            </Grid>
                            <ComboBox x:Name="OutputDeviceCombo" Style="{StaticResource DarkComboBox}" />
                            <TextBlock Text="The speaker or headset under test" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,6,0,0" />

                            <TextBlock Text="MICROPHONE INPUT" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" />
                            <ComboBox x:Name="InputDeviceCombo" Style="{StaticResource DarkComboBox}" />
                            <TextBlock Text="Use a built-in or USB mic; avoid a Bluetooth headset mic" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="1" Width="1" Background="{StaticResource StrokeBrush}" HorizontalAlignment="Center" Margin="0,0,0,1" />

                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRIALS" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TrialCountText" Grid.Column="1" Text="10" Foreground="#EDF1F7" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <Slider x:Name="TrialCountSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="3" Maximum="30" Value="10"
                                    IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="3" Margin="0,0,0,16"
                                    ValueChanged="TrialCountSlider_ValueChanged" />

                            <TextBlock Grid.Row="2" Text="PLAYBACK LEVEL" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="VolumeText" Grid.Row="2" Grid.Column="1" Text="20%" Foreground="#EDF1F7" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <Slider x:Name="VolumeSlider" Grid.Row="3" Grid.ColumnSpan="2" Minimum="1" Maximum="80" Value="20"
                                    IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5" Margin="0,0,0,16"
                                    ValueChanged="VolumeSlider_ValueChanged" />

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DISTANCE FROM MIC" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBox x:Name="DistanceTextBox" Style="{StaticResource DarkTextBox}" Width="74" Height="34" Text="0"
                                         HorizontalContentAlignment="Right" PreviewTextInput="DistanceTextBox_PreviewTextInput" />
                                <TextBlock Text="cm" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="Optional sound travel compensation" Foreground="{StaticResource FaintBrush}" FontSize="11" VerticalAlignment="Center" Margin="13,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Grid.Column="0" Content="▶   Start test" Style="{StaticResource PrimaryButton}"
                                    Click="StartButton_Click" MinWidth="148" />
                            <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel test" Style="{StaticResource DangerButton}"
                                    Click="CancelButton_Click" MinWidth="148" Visibility="Collapsed" />
                            <TextBlock Grid.Column="1" Text="No sound plays until you start a test. Begin at a conservative volume."
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="15,0" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="3–30 trials" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ActivityPanel" Visibility="Collapsed" Background="#14221F" BorderBrush="#28564D" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MEASUREMENT IN PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="ActivityMessage" Text="Preparing audio devices…" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ProgressCountText" Grid.Column="1" Text="0 / 10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <ProgressBar x:Name="TrialProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Background="#26332F" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,15,0,0" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MIC LEVEL DURING CAPTURE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ProgressBar x:Name="MicMeter" Minimum="0" Maximum="1" Value="0" Height="8" Width="210" Margin="14,0,10,0"
                                         Background="#26332F" Foreground="#65D6C0" BorderThickness="0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MicMeterText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,9,0" />
                                    <TextBlock Text="Results" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock x:Name="RunSummaryText" Text="Complete a test to see the queue-adjusted estimate and trial details."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="20,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ExportJsonButton" Content="Export JSON…" Style="{StaticResource BaseButton}" Margin="0,0,7,0"
                                        Click="ExportJsonButton_Click" IsEnabled="False" />
                                <Button x:Name="ExportCsvButton" Content="Export CSV…" Style="{StaticResource BaseButton}"
                                        Click="ExportCsvButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1B2929" BorderBrush="#3A6B60" BorderThickness="1" CornerRadius="11" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="MEDIAN QUEUE-ADJUSTED LATENCY" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MedianResultText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,3" />
                                    <TextBlock Text="Estimate after removing this test's app queue" Foreground="{StaticResource FaintBrush}" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RawMedianResultText" Text="Raw app-to-mic median: —" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="QueueMedianResultText" Text="App queue median: —" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" BorderBrush="#303844" BorderThickness="1" CornerRadius="11" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="QUEUE-ADJUSTED JITTER · STANDARD DEVIATION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="JitterResultText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,3" />
                                    <TextBlock Text="across accepted queue-adjusted trials" Foreground="{StaticResource FaintBrush}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource PanelAltBrush}" BorderBrush="#303844" BorderThickness="1" CornerRadius="11" Padding="15,13">
                                <StackPanel>
                                    <TextBlock Text="EXTRA OUTPUT DELAY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExtraDelayText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,3" />
                                    <TextBlock Text="vs. wired reference run" Foreground="{StaticResource FaintBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="NegativeQueueAdjustedWarning" Visibility="Collapsed" Background="#322A1E" BorderBrush="#806536" BorderThickness="1"
                                CornerRadius="9" Padding="12,9" Margin="0,11,0,0">
                            <TextBlock Text="A negative queue-adjusted trial was detected. This indicates queue or timestamp uncertainty; it does not mean physical delay is negative."
                                       Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <Border Background="#131920" BorderBrush="#29343C" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,13,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="REFERENCE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock x:Name="ReferenceStateText" Grid.Column="1" Text="No wired reference loaded."
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ComparisonStatusText" Text="Extra delay compares queue-adjusted medians from each run."
                                       Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button x:Name="SetReferenceButton" Content="Set current as wired reference" Style="{StaticResource BaseButton}"
                                        Margin="4,0,0,0" Click="SetReferenceButton_Click" IsEnabled="False" />
                                <Button x:Name="SaveReferenceButton" Content="Save reference…" Style="{StaticResource BaseButton}"
                                        Margin="7,0,0,0" Click="SaveReferenceButton_Click" IsEnabled="False" />
                                <Button x:Name="LoadReferenceButton" Content="Load reference…" Style="{StaticResource BaseButton}"
                                        Margin="7,0,0,0" Click="LoadReferenceButton_Click" />
                                <Button x:Name="ClearReferenceButton" Content="Clear" Style="{StaticResource QuietButton}"
                                        Margin="4,0,0,0" Click="ClearReferenceButton_Click" IsEnabled="False" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,9,0" />
                                <TextBlock Text="Trial consistency" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Queue-adjusted latency by trial · accepted samples shown in teal" Foreground="{StaticResource FaintBrush}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Border Background="#12171D" BorderBrush="#29313B" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,14">
                            <Canvas x:Name="TrialChartCanvas" Height="150" SizeChanged="TrialChartCanvas_SizeChanged" />
                        </Border>
                        <DataGrid x:Name="TrialsDataGrid" ItemsSource="{Binding TrialRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" Background="#171B22" BorderBrush="#303844" BorderThickness="1"
                                  RowHeaderWidth="0" MinHeight="120" MaxHeight="260" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="70" />
                                <DataGridTextColumn Header="ADJUSTED" Binding="{Binding QueueAdjustedLatencyText}" Width="1.25*" />
                                <DataGridTextColumn Header="RAW APP-TO-MIC" Binding="{Binding LatencyText}" Width="1.45*" />
                                <DataGridTextColumn Header="APP QUEUE" Binding="{Binding QueueMs, StringFormat={}{0:F1} ms}" Width="1.15*" />
                                <DataGridTextColumn Header="CORRELATION" Binding="{Binding QualityText}" Width="1.15*" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="#171B22" BorderBrush="#2B333F" BorderThickness="1" CornerRadius="15" Padding="19,17">
                    <StackPanel>
                        <TextBlock Text="Measurement notes" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20">
                            <Run Text="Raw app-to-mic latency measures from buffer submission to the corresponding timestamped microphone sample. It includes this endpoint's app queue, Windows and device behavior, the acoustic path, plus any uncompensated input delay; it is not callback delivery latency." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,6,0,0">
                            <Run Text="Queue-adjusted latency subtracts only the estimated queue at this test's audio endpoint. It remains an estimate and still includes Windows, device and acoustic behavior, plus uncompensated input delay. Other apps may use different buffering, so their end-to-end delay can differ. Distance compensation applies to the measurements." />
                        </TextBlock>
                        <TextBlock Text="Start at a conservative volume. A built-in or USB microphone is recommended; Bluetooth headset microphones can add substantial input delay. Exported files contain measurement data only, never audio recordings."
                                   TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
